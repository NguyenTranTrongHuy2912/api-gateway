# Mongo (Database lưu trữ phụ trợ và phân quyền)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=chat_db

# Call Java gRPC Backend
JAVA_GRPC_TARGET=localhost:50051
GRPC_TIMEOUT=15.0

# Bảo mật JWT (Bắt buộc phải điền chuỗi ngẫu nhiên dài)
JWT_SECRET=
JWT_EXPIRE_DAYS=3

# Danh sách email Admin hệ thống (phân tách bởi dấu phẩy, không ghi cứng trong code)
ADMIN_EMAILS=

# Cấu hình CORS (Ví dụ: http://localhost:8081,https://mychatapp.com hoặc để trống để cho phép tất cả)
ALLOWED_ORIGINS=

# Cloudinary (Lưu trữ ảnh & video chat)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chatapp

# Google Gemini API AI Assistant (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình Email SMTP (Dành cho OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OTP_SECRET=
