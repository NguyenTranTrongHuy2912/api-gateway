# Set before starting the gateway, e.g. PowerShell: $env:JWT_SECRET = "<long random string>"
JWT_SECRET=

# Cloudinary: ảnh chat. Lấy ở Cloudinary Dashboard > Settings > API Keys.
# API_SECRET chỉ đặt ở đây, không đưa vào app hay commit lên git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chatapp
